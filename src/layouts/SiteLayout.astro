---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: "home" | "architecture" | "devices" | "emulation";
}

const { title, description, current = "home" } = Astro.props;

const navItems = [
  { label: "Overview", href: "/", key: "home" },
  { label: "Architecture", href: "/architecture/", key: "architecture" },
  { label: "Devices", href: "/devices/", key: "devices" },
  { label: "Emulation", href: "/emulation/", key: "emulation" },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <title>{title} · December Reach</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-frame">
      <header class="site-header">
        <a class="brand" href="/" aria-label="December Reach home">
          <img src="/logo.svg" alt="" width="42" height="42" />
          <span class="brand-wordmark">December Reach</span>
        </a>

        <nav class="pivot-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["pivot-link", { "is-active": current === item.key }]}
              aria-current={current === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="pivot-link source-link" href="https://github.com/DecemberReach/reach-to-be-reached" target="_blank" rel="noreferrer">
            OS source <span aria-hidden="true">↗</span>
          </a>
        </nav>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-main">
          <a class="brand footer-brand" href="/" aria-label="December Reach home">
            <img src="/logo.svg" alt="" width="32" height="32" />
            <span class="brand-wordmark">December Reach</span>
          </a>
          <p>Independent operating system development.</p>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} December Reach</span>
          <a href="https://github.com/DecemberReach" target="_blank" rel="noreferrer">GitHub organization ↗</a>
        </div>
      </footer>
    </div>
  </body>
</html>
