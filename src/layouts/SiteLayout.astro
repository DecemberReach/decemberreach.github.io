---
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  current?: "projects" | "architecture" | "devices" | "emulation";
}

const { title, description, current = "projects" } = Astro.props;

const navItems = [
  { label: "Projects", href: "/", key: "projects" },
  { label: "Architecture", href: "/architecture/", key: "architecture" },
  { label: "Devices", href: "/devices/", key: "devices" },
  { label: "Emulation", href: "/emulation/", key: "emulation" },
] as const;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#ffffff" />
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={Astro.url.href} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={Astro.url.href} />
    <link rel="preload" href="/fonts/open-sans/open-sans-variable.ttf" as="font" type="font/ttf" crossorigin />
    <title>{title} · December Reach</title>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <div class="site-shell">
      <header class="site-header">
        <a class="brand" href="/" aria-label="December Reach home">
          <img src="/logo.svg" alt="" width="38" height="38" />
          <span>December Reach</span>
        </a>

        <nav class="primary-nav" aria-label="Main navigation">
          {navItems.map((item) => (
            <a
              href={item.href}
              class:list={["nav-link", { "is-active": current === item.key }]}
              aria-current={current === item.key ? "page" : undefined}
            >
              {item.label}
            </a>
          ))}
          <a class="nav-link nav-source" href="https://github.com/DecemberReach/reach-to-be-reached" target="_blank" rel="noreferrer">
            Source
          </a>
        </nav>
      </header>

      <main id="main-content">
        <slot />
      </main>

      <footer class="site-footer">
        <div class="footer-brand">
          <img src="/logo.svg" alt="" width="28" height="28" />
          <span>December Reach</span>
        </div>
        <div class="footer-meta">
          <span>© {new Date().getFullYear()} December Reach</span>
          <a href="https://github.com/DecemberReach" target="_blank" rel="noreferrer">GitHub organization</a>
        </div>
      </footer>
    </div>
  </body>
</html>
