---
interface Props {
  current?: "hub" | "projects" | "platform" | "resources";
}

const { current } = Astro.props;

const items = [
  { label: "Home", href: "/", key: "hub" },
  { label: "Projects", href: "/project/", key: "projects" },
  { label: "Platform", href: "/platform/", key: "platform" },
  { label: "Resources", href: "/resources/", key: "resources" }
] as const;
---
<nav class="primary-nav site-navigation" aria-label="Main navigation">
  {items.map((item) => (
    <a
      href={item.href}
      class:list={["nav-link", { "is-active": current === item.key }]}
      aria-current={current === item.key ? "page" : undefined}
    >
      {item.label}
    </a>
  ))}
  <a class="nav-link nav-source" href="https://github.com/DecemberReach" target="_blank" rel="noreferrer">
    GitHub
  </a>
</nav>
