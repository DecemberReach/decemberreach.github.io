---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout
  title="Projects"
  description="Operating-system projects from December Reach."
  current="projects"
>
  <header class="page-heading projects-heading">
    <p class="page-context">December Reach</p>
    <h1>Projects</h1>
  </header>

  <section class="project-board" aria-label="Operating-system projects">
    <article class="project-tile">
      <div class="project-topline">
        <span class="project-category">Desktop environment</span>
        <span class="project-target">x86_64</span>
      </div>
      <div class="project-bottom">
        <h2>auroraADE</h2>
        <a class="project-repository" href="https://github.com/critical-dummy/auroraADE-AI-Development-Test" target="_blank" rel="noreferrer">Development repository</a>
      </div>
    </article>

    <article class="project-tile project-tile-neutral">
      <div class="project-topline">
        <span class="project-category">Operating system project</span>
      </div>
      <div class="project-bottom">
        <h2>haloDOT</h2>
      </div>
    </article>

    <article class="project-tile project-tile-blue">
      <div class="project-topline">
        <span class="project-category">Television operating system</span>
      </div>
      <div class="project-bottom">
        <h2>stellaOS</h2>
      </div>
    </article>
  </section>
</SiteLayout>
