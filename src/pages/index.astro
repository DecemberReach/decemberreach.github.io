---
import SiteLayout from "../layouts/SiteLayout.astro";
---
<SiteLayout
  title="December Reach"
  description="Operating-system projects and platform documentation from December Reach."
  current="home"
>
  <section class="directory-heading">
    <h1>Operating systems</h1>
  </section>

  <section class="directory-section" aria-labelledby="projects-title">
    <header class="directory-label">
      <h2 id="projects-title">Projects</h2>
    </header>
    <div class="directory-content project-list">
      <div class="directory-row">
        <h3>auroraADE</h3>
        <p>Desktop environment · x86_64 target</p>
      </div>
      <div class="directory-row">
        <h3>haloDOT</h3>
        <p>Operating system project</p>
      </div>
      <div class="directory-row">
        <h3>stellaOS</h3>
        <p>Television operating system</p>
      </div>
    </div>
  </section>

  <section class="directory-section" aria-labelledby="platform-title">
    <header class="directory-label">
      <h2 id="platform-title">Platform</h2>
    </header>
    <div class="directory-content">
      <div class="directory-row">
        <h3>Fabric Dessert</h3>
        <p>Virtual hardware platform and board architecture for reachOS.</p>
      </div>
      <div class="directory-row">
        <h3>FRT64</h3>
        <p>CPU integration boundary for ARM32, ARM64, x86_32 and x86_64.</p>
      </div>
      <div class="directory-row">
        <h3>Physical memory</h3>
        <p>64-bit BigInt addressing with sparse 64 KiB backing chunks.</p>
      </div>
      <div class="directory-row">
        <h3>Device bus</h3>
        <p>MMIO windows, alignment, interrupt lines and device enumeration.</p>
      </div>
      <div class="directory-row">
        <h3>Display</h3>
        <p>1080 × 2424 RGBA8888 framebuffer.</p>
      </div>
      <a class="directory-link" href="/architecture/">Architecture documentation <span aria-hidden="true">→</span></a>
    </div>
  </section>

  <section class="directory-section" aria-labelledby="documentation-title">
    <header class="directory-label">
      <h2 id="documentation-title">Documentation</h2>
    </header>
    <div class="directory-content document-index">
      <a class="directory-row directory-row-link" href="/architecture/">
        <h3>Architecture</h3>
        <p>reachOS, Fabric Dessert, FRT64, memory, devices and display.</p>
        <span aria-hidden="true">→</span>
      </a>
      <a class="directory-row directory-row-link" href="/devices/">
        <h3>Devices</h3>
        <p>Published integration notes for desktop and mobile targets.</p>
        <span aria-hidden="true">→</span>
      </a>
      <a class="directory-row directory-row-link" href="/emulation/">
        <h3>Emulation</h3>
        <p>OS source acquisition, JavaScript backend execution and web access.</p>
        <span aria-hidden="true">→</span>
      </a>
    </div>
  </section>

  <section class="directory-section directory-source" aria-labelledby="source-title">
    <header class="directory-label">
      <h2 id="source-title">Source</h2>
    </header>
    <div class="directory-content">
      <a class="source-repository" href="https://github.com/DecemberReach/reach-to-be-reached" target="_blank" rel="noreferrer">
        DecemberReach / reach-to-be-reached <span aria-hidden="true">↗</span>
      </a>
    </div>
  </section>
</SiteLayout>
