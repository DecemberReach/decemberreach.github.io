---
import SiteLayout from "../layouts/SiteLayout.astro";

const photos = {
  home: {
    src: "https://images.unsplash.com/photo-1429081172764-c0ee67ab9afd?auto=format&fit=crop&w=1800&q=80",
    page: "https://unsplash.com/photos/landscape-photography-of-mountain-and-lake-EKIyHUrUHWU",
    photographer: "Adriel Kloppenburg",
    alt: "Golden hills and a mountain valley under a clear sky"
  },
  aurora: {
    src: "https://images.unsplash.com/photo-1531764411937-45495415d84d?auto=format&fit=crop&w=1600&q=80",
    page: "https://unsplash.com/photos/landscape-photography-of-lake-and-mountains-bXGUdxFeQUQ",
    photographer: "Ryan Stone",
    alt: "Lake Louise surrounded by forested mountains"
  },
  halo: {
    src: "https://images.unsplash.com/photo-1465056836041-7f43ac27dcb5?auto=format&fit=crop&w=1100&q=80",
    page: "https://unsplash.com/photos/landscape-photography-of-lake-and-mountain-73F4pKoUkM0",
    photographer: "Tobias Keller",
    alt: "Lake Tekapo and a snow-covered mountain range at sunset"
  },
  stella: {
    src: "https://images.unsplash.com/photo-1516941072577-aecd44b927bf?auto=format&fit=crop&w=1100&q=80",
    page: "https://unsplash.com/photos/landscape-photography-of-mountain-and-lake-kyDyOHkIbC8",
    photographer: "Marc-Olivier Jodoin",
    alt: "Tiger Leaping Gorge in warm sunlight"
  }
};
---
<SiteLayout
  title="Home"
  description="December Reach projects and resources."
  current="hub"
>
  <div class="hub-workspace">
    <aside class="hub-sidebar" aria-label="Home categories">
      <button
        class="hub-nav-button is-selected"
        type="button"
        data-hub-tab="projects"
        aria-pressed="true"
        aria-controls="hub-panel-projects"
      >Projects</button>
      <button
        class="hub-nav-button"
        type="button"
        data-hub-tab="website"
        aria-pressed="false"
        aria-controls="hub-panel-website"
      >Website versions</button>

      <div class="hub-sidebar-rule"></div>
      <a class="hub-source-link" href="https://github.com/DecemberReach/reach-to-be-reached" target="_blank" rel="noreferrer">
        reach-to-be-reached
      </a>
    </aside>

    <div class="hub-content">
      <section class="hub-panel" id="hub-panel-projects" data-hub-panel="projects" aria-labelledby="hub-projects-title">
        <header class="hub-content-heading">
          <h1 id="hub-projects-title">Projects</h1>
          <a class="hub-all-projects" href="/project/">View all projects</a>
        </header>

        <div class="hub-tile-board">
          <a class="hub-tile hub-tile-feature" href="/project/auroraADE/">
            <img
              src={photos.aurora.src}
              alt={photos.aurora.alt}
              loading="eager"
              fetchpriority="high"
              style="view-transition-name: project-auroraADE"
            />
            <span class="hub-tile-caption">
              <span class="hub-tile-type">Operating system · x86_64</span>
              <strong>auroraADE</strong>
            </span>
          </a>

          <a class="hub-tile hub-tile-secondary" href="/project/haloDOT/">
            <img
              src={photos.halo.src}
              alt={photos.halo.alt}
              loading="lazy"
              style="view-transition-name: project-haloDOT"
            />
            <span class="hub-tile-caption">
              <span class="hub-tile-type">Operating system project</span>
              <strong>haloDOT</strong>
            </span>
          </a>

          <a class="hub-tile hub-tile-secondary" href="/project/stellaOS/">
            <img
              src={photos.stella.src}
              alt={photos.stella.alt}
              loading="lazy"
              style="view-transition-name: project-stellaOS"
            />
            <span class="hub-tile-caption">
              <span class="hub-tile-type">Television operating system</span>
              <strong>stellaOS</strong>
            </span>
          </a>
        </div>

        <p class="hub-artwork-credit">
          Photos:
          <a href={photos.aurora.page} target="_blank" rel="noreferrer">auroraADE — {photos.aurora.photographer}</a>,
          <a href={photos.halo.page} target="_blank" rel="noreferrer">haloDOT — {photos.halo.photographer}</a>,
          <a href={photos.stella.page} target="_blank" rel="noreferrer">stellaOS — {photos.stella.photographer}</a>
          / Unsplash
        </p>
      </section>

      <section class="hub-panel" id="hub-panel-website" data-hub-panel="website" aria-labelledby="hub-website-title" hidden>
        <header class="hub-content-heading">
          <h1 id="hub-website-title">Website versions</h1>
        </header>

        <div class="hub-version-board">
          <a class="hub-tile hub-version-tile" href="/">
            <img src={photos.home.src} alt={photos.home.alt} loading="lazy" />
            <span class="hub-tile-caption">
              <span class="hub-tile-type">Current website · Version 1.1</span>
              <strong>Reach Hub</strong>
            </span>
          </a>
          <div class="hub-version-info">
            <p class="hub-version-number">1.1</p>
            <h2>Reach Hub</h2>
            <p>December Reach website · Current release</p>
            <a href="https://github.com/DecemberReach/decemberreach.github.io" target="_blank" rel="noreferrer">Website repository</a>
          </div>
        </div>

        <p class="hub-artwork-credit">
          Photo:
          <a href={photos.home.page} target="_blank" rel="noreferrer">{photos.home.photographer}</a>
          / Unsplash
        </p>
      </section>
    </div>
  </div>

  <script>
    const hubTabs = Array.from(document.querySelectorAll("[data-hub-tab]"));
    const hubPanels = Array.from(document.querySelectorAll("[data-hub-panel]"));

    hubTabs.forEach((tab) => {
      tab.addEventListener("click", () => {
        const selected = tab.getAttribute("data-hub-tab");
        hubTabs.forEach((item) => {
          const active = item === tab;
          item.setAttribute("aria-pressed", String(active));
          item.classList.toggle("is-selected", active);
        });
        hubPanels.forEach((panel) => {
          panel.hidden = panel.getAttribute("data-hub-panel") !== selected;
        });
      });
    });
  </script>

  <script>
    const projectLaunchTiles = Array.from(document.querySelectorAll(".hub-tile[href^='/project/']"));
    const launchReducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    projectLaunchTiles.forEach((tile) => {
      tile.addEventListener("click", (event) => {
        if (
          event.defaultPrevented ||
          event.button !== 0 ||
          event.metaKey || event.ctrlKey || event.shiftKey || event.altKey ||
          tile.target === "_blank" ||
          tile.hasAttribute("download") ||
          launchReducedMotion.matches
        ) return;

        const destination = new URL(tile.href, window.location.href);
        if (destination.origin !== window.location.origin) return;

        const bounds = tile.getBoundingClientRect();
        if (!bounds.width || !bounds.height) return;

        event.preventDefault();
        const overlay = document.createElement("div");
        overlay.className = "project-launch-overlay";
        overlay.setAttribute("aria-hidden", "true");

        const stage = document.createElement("div");
        stage.className = "project-launch-stage";

        const plane = document.createElement("div");
        plane.className = "project-launch-plane";

        // Copy only the tile's visible contents. Do not copy the tile's
        // isolation/stacking context into the 3D face.
        const front = document.createElement("div");
        front.className = "project-launch-front";
        Array.from(tile.children).forEach((child) => {
          front.append(child.cloneNode(true));
        });

        const projectName =
          tile.querySelector(".hub-tile-caption strong")?.textContent?.trim() ||
          "December Reach";

        const back = document.createElement("div");
        back.className = "project-launch-back";
        back.setAttribute("aria-hidden", "true");

        const backKicker = document.createElement("span");
        backKicker.className = "project-launch-back-kicker";
        backKicker.textContent = "DECEMBER REACH";

        const backTitle = document.createElement("strong");
        backTitle.className = "project-launch-back-title";
        backTitle.textContent = projectName;

        back.append(backKicker, backTitle);
        plane.append(front, back);

        Object.assign(plane.style, {
          left: `${bounds.left}px`,
          top: `${bounds.top}px`,
          width: `${bounds.width}px`,
          height: `${bounds.height}px`,
          "--launch-x": `${window.innerWidth / 2 - bounds.left - bounds.width / 2}px`,
          "--launch-y": `${window.innerHeight / 2 - bounds.top - bounds.height / 2}px`,
          "--launch-scale-x": String(window.innerWidth / bounds.width),
          "--launch-scale-y": String(window.innerHeight / bounds.height),
        });

        stage.append(plane);
        overlay.append(stage);
        document.body.append(overlay);
        document.documentElement.classList.add("project-launching");
        document.body.classList.add("project-launching");

        let navigated = false;
        const navigate = () => {
          if (navigated) return;
          navigated = true;
          try {
            sessionStorage.setItem("dr-project-launch-enter", "1");
          } catch {
            // Navigation still works when session storage is unavailable.
          }
          window.location.assign(destination.href);
        };

        plane.addEventListener("animationend", (animationEvent) => {
          if (animationEvent.animationName === "project-plane-launch") navigate();
        }, { once: true });

        window.setTimeout(navigate, 1800);
      });
    });
  </script>

</SiteLayout>
