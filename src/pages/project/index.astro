---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects, sharedOSRepository } from "../../data/projects";

const featuredProject = projects[0];
const otherProjects = projects.slice(1);
---
<SiteLayout
  title="Projects"
  description="Operating systems and software projects from December Reach."
  current="projects"
>
  <div class="software-directory">
    <header class="software-directory-heading">
      <div>
        <p class="software-section-kicker">December Reach</p>
        <h1>Projects</h1>
        <p>Operating systems and software developed by December Reach.</p>
      </div>
      <a href={sharedOSRepository} target="_blank" rel="noreferrer">Shared source repository</a>
    </header>

    <section class="software-featured-project" aria-labelledby="featured-project-title">
      <a class="software-featured-art" href={"/project/" + featuredProject.slug + "/"} aria-label={"Explore " + featuredProject.name}>
        <img src={featuredProject.image} alt={featuredProject.imageAlt} fetchpriority="high" />
      </a>
      <div class="software-featured-copy">
        <p class="software-product-category">{featuredProject.category}</p>
        <h2 id="featured-project-title">{featuredProject.name}</h2>
        <p>{featuredProject.summary}</p>
        <a class="software-primary-link" href={"/project/" + featuredProject.slug + "/"}>Explore {featuredProject.name}</a>
      </div>
    </section>

    <section class="software-directory-list" aria-labelledby="all-projects-title">
      <div class="software-section-heading">
        <div>
          <p class="software-section-kicker">Software</p>
          <h2 id="all-projects-title">More projects</h2>
        </div>
      </div>

      <div class="software-directory-grid">
        {otherProjects.map((project) => (
          <a class="software-directory-card" href={"/project/" + project.slug + "/"} key={project.slug}>
            <img src={project.image} alt={project.imageAlt} loading="lazy" />
            <div class="software-directory-card-copy">
              <span>{project.category}</span>
              <h3>{project.name}</h3>
              <p>{project.summary}</p>
              <strong>Explore project <span class="mif-arrow-right" aria-hidden="true"></span></strong>
            </div>
          </a>
        ))}
      </div>
    </section>

    <section class="software-shared-source">
      <div>
        <p class="software-section-kicker">Development</p>
        <h2>One repository. Separate OS projects.</h2>
        <p>Each operating system is developed in its own directory inside the shared repository.</p>
      </div>
      <a href={sharedOSRepository} target="_blank" rel="noreferrer">Open repository <span class="mif-arrow-right" aria-hidden="true"></span></a>
    </section>
  </div>
</SiteLayout>
