---
import SiteLayout from "../../layouts/SiteLayout.astro";
import { projects, sharedOSRepository, type Project } from "../../data/projects";

export function getStaticPaths() {
  return projects.map((project) => ({
    params: { slug: project.slug },
    props: { project }
  }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const relatedProjects = projects.filter((item) => item.slug !== project.slug);
---
<SiteLayout
  title={project.name}
  description={project.summary + " · December Reach"}
  current="projects"
>
  <div class="software-product">
    <nav class="software-breadcrumb" aria-label="Breadcrumb">
      <a href="/project/">Projects</a>
      <span aria-hidden="true">/</span>
      <span aria-current="page">{project.name}</span>
    </nav>

    <section class="software-product-hero" aria-labelledby="software-product-title">
      <div class="software-product-copy">
        <p class="software-product-category">{project.category}</p>
        <h1 id="software-product-title">{project.name}</h1>
        <p class="software-product-summary">{project.summary}</p>
        <div class="software-product-actions">
          <a class="software-primary-link" href={sharedOSRepository} target="_blank" rel="noreferrer">
            View source repository
          </a>
          <a class="software-secondary-link" href="/project/">All projects</a>
        </div>
      </div>

      <figure class="software-product-art">
        <img
          src={project.image}
          alt={project.imageAlt}
          fetchpriority="high"
          style={"view-transition-name: project-" + project.slug}
        />
        <figcaption>
          <a href={project.photoPage} target="_blank" rel="noreferrer">
            Photo by {project.photographer} / Unsplash
          </a>
          <span>Temporary artwork</span>
        </figcaption>
      </figure>
    </section>

    <section class="software-product-overview" id="overview" aria-labelledby="software-overview-title">
      <div class="software-section-heading">
        <div>
          <p class="software-section-kicker">Overview</p>
          <h2 id="software-overview-title">About {project.name}</h2>
        </div>
        <p>{project.description}</p>
      </div>

      <div class="software-facts" aria-label="Project information">
        {project.facts.map((fact) => (
          <div class="software-fact">
            <span>{fact.label}</span>
            <strong>{fact.value}</strong>
          </div>
        ))}
      </div>
    </section>

    {project.highlights.length > 0 && (
      <section class="software-capabilities" id="technical-details" aria-labelledby="software-capabilities-title">
        <div class="software-section-heading">
          <div>
            <p class="software-section-kicker">Technical overview</p>
            <h2 id="software-capabilities-title">How it is built</h2>
          </div>
          <p>Confirmed implementation details for {project.name}.</p>
        </div>

        <div class="software-capability-grid">
          {project.highlights.map((item) => (
            <article class="software-capability">
              <span>{item.title}</span>
              <h3>{item.value}</h3>
              <p>{item.description}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    <section class="software-source" aria-labelledby="software-source-title">
      <div>
        <p class="software-section-kicker">Source code</p>
        <h2>Developed in one shared repository.</h2>
        <p>Each operating-system project has its own development directory.</p>
      </div>
      <a href={sharedOSRepository} target="_blank" rel="noreferrer">
        DecemberReach / reach-to-be-reached
      </a>
    </section>

    <section class="software-related" aria-labelledby="software-related-title">
      <div class="software-section-heading">
        <div>
          <p class="software-section-kicker">Explore</p>
          <h2 id="software-related-title">More projects</h2>
        </div>
        <a class="software-text-link" href="/project/">Browse all projects</a>
      </div>

      <div class="software-related-grid">
        {relatedProjects.map((item) => (
          <a class="software-related-card" href={"/project/" + item.slug + "/"} key={item.slug}>
            <img src={item.image} alt={item.imageAlt} loading="lazy" />
            <div>
              <span>{item.category}</span>
              <h3>{item.name}</h3>
              <p>{item.summary}</p>
              <strong>Explore project <span aria-hidden="true">→</span></strong>
            </div>
          </a>
        ))}
      </div>
    </section>
  </div>
</SiteLayout>
